# Copy this file to secrets.yaml when compiling milieu-panel-private.yaml.
# Generate api_encryption_key with: esphome config (or Home Assistant ESPHome Builder)

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
api_encryption_key: "YOUR_32_BYTE_BASE64_NOISE_KEY="
ota_password: "YOUR_OTA_PASSWORD"
